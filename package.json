// server.js
const express = require('express');
const cors = require('cors');
const dotenv = require('dotenv');

dotenv.config();

const app = express();
app.use(cors());
app.use(express.json());

// simple health check so Render knows we're alive
app.get('/', (_req, res) => {
  res.status(200).send('CaribPay backend running');
});

// example protected env usage (set these in Render → Environment)
const JWT_SECRET = process.env.JWT_SECRET || 'dev-secret';

// your routes would go here…

// IMPORTANT: listen on Render's port and bind 0.0.0.0
const PORT = process.env.PORT || 3000;
app.listen(PORT, '0.0.0.0', () => {
  console.log(`Server listening on http://0.0.0.0:${PORT}`);
});
