{
  "expo": {
    "name": "CaribPay",
    "slug": "caribpay",
    "scheme": "caribpay",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#070B0C"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yourname.caribpay"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#070B0C"
      },
      "package": "com.yourname.caribpay"
    },
    "plugins": ["expo-secure-store", "expo-local-authentication"]
  }
}
